# =============================================================================
# Cluster configuration — edit this, then run the scripts.
# Every script sources this file. Keep it identical on all nodes.
# =============================================================================

# ---- Kubernetes version ------------------------------------------------------
# K8S_MINOR="latest" auto-detects the newest stable minor from upstream
# (https://dl.k8s.io/release/stable.txt) at install time. Pin a minor (e.g.
# 1.36) for reproducible installs. Leave K8S_PATCH empty for the latest patch on
# that track, or pin it (e.g. 1.37.0) for a fully reproducible build.
K8S_MINOR="latest"        # "latest" = newest stable, or pin e.g. 1.37 / 1.36
K8S_PATCH=""              # e.g. 1.37.0  (empty = latest patch in the minor)

# ---- Container runtime -------------------------------------------------------
CONTAINERD_VERSION=""     # empty = distro default from Docker repo

# ---- Networking --------------------------------------------------------------
POD_CIDR="10.244.0.0/16"      # must match the CNI (Flannel default = 10.244/16)
SERVICE_CIDR="10.96.0.0/12"
CNI="flannel"                 # flannel | calico   (calico needs POD_CIDR=192.168.0.0/16)

# ---- Control plane / HA ------------------------------------------------------
# HA_MODE=single  -> one master, API server reached on its own IP.
# HA_MODE=multi   -> stacked-etcd HA; point CONTROL_PLANE_ENDPOINT at a
#                    load balancer (or keepalived VIP) in front of all masters.
HA_MODE="single"                     # single | multi
CONTROL_PLANE_ENDPOINT="k8s-api.local:6443"   # VIP:6443 or LB DNS (multi); ignored for single unless set
APISERVER_ADVERTISE_ADDRESS=""        # this node's IP; empty = auto-detect default route IP

# ---- Storage -----------------------------------------------------------------
# Pick ONE backend:
#   longhorn -> distributed replicated block storage on the nodes themselves
#   nfs      -> dynamic PVCs backed by an EXTERNAL NFS server (set NFS_* below;
#               prepare the server with scripts/nfs-server-setup.sh)
#   none     -> skip storage
STORAGE="longhorn"                    # longhorn | nfs | none

# Longhorn options
LONGHORN_VERSION="v1.10.0"
LONGHORN_SET_DEFAULT_SC="true"        # make longhorn the default StorageClass

# NFS options (used only when STORAGE=nfs)
NFS_SERVER=""                         # NFS server IP/host, e.g. 192.168.18.69
NFS_PATH="/srv/nfs/k8s"               # exported directory on that server
NFS_SC_NAME="nfs-client"              # StorageClass name to create
NFS_SET_DEFAULT_SC="true"             # make nfs-client the default StorageClass
NFS_PROVISIONER_IMAGE="registry.k8s.io/sig-storage/nfs-subdir-external-provisioner:v4.0.2"
